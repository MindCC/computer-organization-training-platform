# 计算机组成原理实训平台 - 环境变量示例
# 本文件仅作示例，项目不加载 .env 文件（未内置 dotenv）。
# 请在启动进程的环境中注入变量（export / pm2 / systemd / 容器环境），例如：
#
#   export DEEPSEEK_API_KEY=sk-xxx
#   export SESSION_SECRET=change-me
#   npm run server
#
# .env 已加入 .gitignore，即使创建也不会被提交，但同样不会被自动读取。

# ── 必填 ──

# 会话签名密钥：生产环境必须设置为随机长字符串。
# 未配置时开发环境使用固定默认值；生产模式（NODE_ENV=production）下缺失将拒绝启动。
SESSION_SECRET=please-generate-a-long-random-secret

# 智能助教用的 DeepSeek API 密钥（https://platform.deepseek.com）
# 不配置时 AI 报告自动降级为本地规则建议，平台其余功能不受影响。
DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 思维画板：文字默认复用 DeepSeek，未配置时使用本地提纲整理。
# 图片转导图需要另行配置支持 image_url 的视觉模型（OpenAI 兼容 Chat Completions）。
# BASE_URL 填写包含 /v1 等接口前缀的地址，不包含 /chat/completions。
# MINDMAP_API_KEY=your-vision-provider-key
# MINDMAP_BASE_URL=https://your-provider.example/v1
# MINDMAP_MODEL=your-vision-model
# MINDMAP_VISION_ENABLED=1
# MINDMAP_TIMEOUT_MS=45000

# ── 可选 ──

# 服务端口（默认 8787）
# PORT=8787

# SQLite 数据库文件路径（默认 data/classroom.sqlite）
# DATABASE_PATH=data/classroom.sqlite

# HTTPS 部署时置 1，为 cookie 追加 Secure 标记（配合 Nginx 反代）
# COOKIE_SECURE=1

# 开放学生和教师一键演示登录（生产环境默认关闭，演示部署可置 1）
# ENABLE_DEMO_LOGIN=1

# 前端外部访问地址（用于 CSRF Origin 校验；默认取请求自身的 Host）
# PUBLIC_BASE_URL=http://your-domain.com

# 反向代理（Nginx 等）后面部署时置 1，让服务信任 X-Forwarded-For / X-Forwarded-Proto。
# 服务直接对外暴露时必须保持注释：否则客户端可以伪造成源 IP，绕过按 IP 的登录限流。
# TRUST_PROXY=1
# TRUST_PROXY_HOPS=1

# 首次 seed 教师账号（默认 teacher / ChangeMe123!）
# TEACHER_USERNAME=teacher
# TEACHER_PASSWORD=ChangeMe123!
# TEACHER_NAME=任课教师
