  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "@xyflow/react": "^12.11.1",
    "better-sqlite3": "^12.11.1",
    "cn-fontsource-smiley-sans-oblique-regular": "^1.0.1",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pptx-preview": "^1.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.185.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "playwright": "^1.61.1"
  }
}
