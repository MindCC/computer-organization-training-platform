    "qa:overview-exploration": "node scripts/run-browser-qa.mjs scripts/verify-overview-exploration.mjs --seed-demo",
    "qa:middle-pan": "node scripts/run-browser-qa.mjs scripts/verify-middle-pan.mjs",
    "preqa:classroom": "npm run build -- --manifest",
    "qa:classroom": "node scripts/run-browser-qa.mjs scripts/verify-classroom.mjs --production",
    "qa:classroom-load": "node scripts/verify-classroom-load.mjs"
