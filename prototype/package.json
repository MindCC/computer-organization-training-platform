    "eval:learning-coach": "node scripts/evaluate-learning-coach.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test src/*.test.mjs src/shared/*.test.mjs src/circuit/*.test.mjs src/components/*.test.mjs src/motion/*.test.mjs scripts/*.test.mjs server/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --import ./server/developmentConfig.js server/server.js",
    "dev:server": "node --import ./server/developmentConfig.js server/server.js",
    "migrate": "node server/migrate.js",
    "seed:teacher": "node server/seedTeacher.js",
    "seed:demo": "node server/seedDemoClassroom.js",
    "preview:site": "node scripts/previewSite.mjs",
    "preview:site:check": "node scripts/previewSite.mjs --check",
    "qa:3d": "node scripts/run-browser-qa.mjs scripts/verify-3d.mjs",
    "preqa:story": "npm run build -- --manifest",
    "qa:story": "node scripts/run-browser-qa.mjs scripts/verify-hardware-story.mjs --production --seed-demo",
