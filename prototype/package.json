    "qa:lab-workbench": "node scripts/run-browser-qa.mjs scripts/verify-lab-workbench.mjs --production --seed-demo",
    "preqa:curriculum": "npm run build -- --manifest",
    "qa:curriculum": "node scripts/run-browser-qa.mjs scripts/verify-workbench-curriculum.mjs --production",
    "preqa:login": "npm run build -- --manifest",
    "qa:login": "node scripts/run-browser-qa.mjs scripts/verify-login-design.mjs --production --seed-demo",
    "preqa:demo-teacher": "npm run build -- --manifest",
    "qa:demo-teacher": "node scripts/run-browser-qa.mjs scripts/verify-demo-teacher.mjs --production --seed-demo",
    "preqa:home": "npm run build -- --manifest",
    "qa:home": "node scripts/run-browser-qa.mjs scripts/verify-home-design.mjs --production --seed-demo",
    "preqa:tree": "npm run build -- --manifest",
    "qa:tree": "node scripts/run-browser-qa.mjs scripts/verify-learning-tree.mjs --production --seed-demo",
    "preqa:learning-integration": "npm run build -- --manifest",
    "qa:learning-integration": "node scripts/run-browser-qa.mjs scripts/verify-learning-integration.mjs --production --seed-demo",
    "preqa:knowledge": "npm run build -- --manifest",
    "qa:knowledge": "node scripts/run-browser-qa.mjs scripts/verify-knowledge-base.mjs --production --seed-demo",
    "preqa:custom-customer": "npm run build -- --manifest",
    "qa:custom-customer": "node scripts/run-browser-qa.mjs scripts/verify-custom-customer.mjs --production --seed-demo --live-ai",
    "preqa:production": "npm run build -- --manifest",
    "qa:production": "node scripts/run-browser-qa.mjs scripts/verify-production-modules.mjs --production && node scripts/run-browser-qa.mjs scripts/verify-3d.mjs --production",
    "qa:assets": "node scripts/verify-asset-budget.mjs",
    "assets:export": "node scripts/export-teaching-pc.mjs",
    "preqa:build-budget": "npm run build -- --manifest",
    "qa:build-budget": "node scripts/verify-build-budget.mjs",
    "preqa:3d-budget": "npm run build -- --manifest",
    "qa:3d-budget": "node scripts/verify-3d-budget.mjs",
    "qa:performance": "node scripts/run-browser-qa.mjs scripts/verify-performance.mjs",
    "qa:ui": "node scripts/run-browser-qa.mjs scripts/verify-ui.mjs",
    "preqa:platform": "npm run build -- --manifest",
    "qa:platform": "node scripts/run-browser-qa.mjs scripts/verify-platform-audit.mjs --production --seed-demo",
    "qa:teacher": "node scripts/run-browser-qa.mjs scripts/verify-teacher-dashboard.mjs",
