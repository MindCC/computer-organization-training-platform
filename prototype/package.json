{
  "name": "prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preqa:mobile": "npm run build -- --manifest",
    "qa:mobile": "node scripts/run-browser-qa.mjs scripts/verify-mobile.mjs --production --seed-demo",
    "preqa:study-planning": "npm run build -- --manifest",
    "qa:study-planning": "node scripts/run-browser-qa.mjs scripts/verify-study-planning.mjs --production",
